# App
NODE_ENV=development
PORT=3000

# ── LaunchDarkly (feature flagging) ──────────────────────────────────────────
# Absent keys are safe: the app falls back to the defaults in
# public/js/flags.js and src/launchdarkly.js and runs normally.
LD_SDK_KEY=sdk-your-server-side-key
LD_CLIENT_SIDE_ID=your-client-side-id
# This branch is an ENVIRONMENT (`sentry`) inside the shared `ToggleTravel`
# project — not a separate project. LD_ENV_KEY has no code default: the project
# also contains a critical `production` environment, and the traffic conductor
# refuses to start the daily guarded rollout rather than guess.
LD_PROJECT_KEY=ToggleTravel
LD_ENV_KEY=sentry
# REST token (Writer) — only the traffic conductor needs this, to start the
# daily guarded rollout on new-checkout-flow.
LD_API_TOKEN=api-your-rest-token
LD_MAINTAINER_ID=

# ── Sentry (observability) ───────────────────────────────────────────────────
# A DSN is a public, write-only credential; it is served to the browser via
# /api/config on purpose. Absent DSN = Sentry disabled, app unaffected.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Database (SQLite). Production uses /var/lib/toggle-travel/toggle.db so the
# file survives deploys, which wipe the checkout directory.
DB_PATH=

# ── Demo simulation ──────────────────────────────────────────────────────────
SIMULATE_LATENCY_MAX_MS=1200
SIMULATE_PAYMENT_FAILURE_RATE=0.05

# ── 24/7 traffic conductor ───────────────────────────────────────────────────
TRAFFIC_ENABLED=false
TRAFFIC_PEAK_INTERVAL_MIN=5
TRAFFIC_TROUGH_INTERVAL_MIN=20
TRAFFIC_API_RPM=20
TRAFFIC_UNIQUE_PCT=70

# Daily guarded-rollout checkout incident
INCIDENT_ENABLED=true
INCIDENT_HOUR_ET=7
INCIDENT_MONITOR_WINDOW_MIN=5
INCIDENT_AUTO_REVERT_MIN=20
INCIDENT_API_RPM=15
INCIDENT_CHECKOUT_COUNT=6

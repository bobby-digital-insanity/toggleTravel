# App
NODE_ENV=development
PORT=3000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-5

# LaunchDarkly
# SDK key (server-side) — from LD dashboard: Environments > your-env > SDK key
LD_SDK_KEY=sdk-your-key-here
# Client-side ID (browser) — from LD dashboard: Environments > your-env > Client-side ID
LD_CLIENT_SIDE_ID=your-client-side-id-here
# REST API access token — used ONLY by scripts/traffic-conductor.js for the daily
# checkout incident (turns new-checkout-flow on/off). Writer role, scoped to ToggleTravel.
LD_API_TOKEN=api-your-token-here
# Project/environment for conductor API calls (defaults shown)
LD_PROJECT_KEY=ToggleTravel
LD_ENV_KEY=launch-darkly

# 24/7 traffic conductor (scripts/traffic-conductor.js — runs under PM2 in production)
TRAFFIC_ENABLED=false            # true on EC2; keep false for local dev
TRAFFIC_PEAK_INTERVAL_MIN=5      # minutes between browser rounds at peak (2pm ET)
TRAFFIC_TROUGH_INTERVAL_MIN=20   # minutes between browser rounds overnight
TRAFFIC_API_RPM=20               # API-tier requests/minute at peak
TRAFFIC_UNIQUE_PCT=70            # % of browser flows using brand-new identities
INCIDENT_ENABLED=true            # daily flag-flip checkout incident
INCIDENT_HOUR_ET=8               # incident start hour (ET)
INCIDENT_AUTO_REVERT_MIN=60      # safety-net auto-revert

# Demo simulation (these are now overridable via LD flags)
SIMULATE_LATENCY_MAX_MS=1200
SIMULATE_PAYMENT_FAILURE_RATE=0.05
